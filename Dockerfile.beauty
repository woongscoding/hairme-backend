# AWS Lambda Python 3.11 base image
# Beauty Lambda: Hair Color 합성 전용 (PIL + Gemini, No PyTorch / MediaPipe / OpenCV)
FROM public.ecr.aws/lambda/python:3.11

# 시스템 패키지 없음: OpenCV/MediaPipe 를 빼면서 mesa-libGL·gcc 등이 필요 없어졌다.
# (남은 의존성은 전부 manylinux 휠로 설치된다)
COPY requirements-beauty.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Copy application code
COPY . ${LAMBDA_TASK_ROOT}/

# Environment variables
ENV PYTHONIOENCODING=utf-8
ENV LAMBDA_TYPE=beauty

# Set the CMD to beauty handler
CMD ["main_beauty.handler"]
